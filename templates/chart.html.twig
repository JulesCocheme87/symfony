{% extends 'base.html.twig' %}

{% block title %}Graphique de Ventes{% endblock %}

{% block body %}
    <h1>Exemple de graphique avec Chart.js</h1>

    <div {{ stimulus_controller('@symfony/ux-chartjs/chart', {
        type: 'bar',
        data: {
            labels: ['Janvier', 'Février', 'Mars', 'Avril'],
            datasets: [{
                label: 'Ventes',
                data: [12, 19, 3, 5],
                backgroundColor: ['#36A2EB', '#FFCE56', '#FF6384', '#4BC0C0']
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    }) }} style="width: 600px; height: 400px;">
    </div>
{% endblock %}
