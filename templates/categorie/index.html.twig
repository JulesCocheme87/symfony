{% extends 'base.html.twig' %}

{% block title %}Gestion des categories{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-5">
            <h2>Ajouter une categorie</h2>
            {{ form_start(my_form) }}
                {{ form_widget(my_form) }}
            {{ form_end(my_form) }}
        </div>
        <div class="col-md-7">
            <h2>Categories existantes</h2>
            {% if categories is not empty %}
                <ul class="list-group">
                    {% for categorie in categories %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>{{ categorie.nom }}</span>
                            <form method="post" action="{{ path('admin_categories_delete', {id: categorie.id}) }}" onsubmit="return confirm('Supprimer la categorie {{ categorie.nom }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_categorie_' ~ categorie.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <div class="alert alert-info">Aucune categorie enregistree.</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
