{% extends 'base.html.twig' %}
{% block title %}Liste des produits{% endblock %}

{% block body %}
    <form method="get" action="{{ path('liste_produits') }}" class="row g-2 align-items-end mb-4">
        <div class="col-md-5">
            <label for="categorie" class="form-label">Filtrer par categorie</label>
            <select id="categorie" name="categorie" class="form-select">
                <option value="0" {% if categorieSelectionneeId == 0 %}selected{% endif %}>Toutes les categories</option>
                {% for categorie in categories %}
                    <option value="{{ categorie.id }}" {% if categorieSelectionneeId == categorie.id %}selected{% endif %}>
                        {{ categorie.nom }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary">Filtrer</button>
            {% if categorieSelectionneeId != 0 %}
                <a href="{{ path('liste_produits') }}" class="btn btn-outline-secondary">Reinitialiser</a>
            {% endif %}
        </div>
    </form>

    {% if categorieSelectionnee %}
        <div class="alert alert-secondary">
            Filtre actif : <strong>{{ categorieSelectionnee.nom }}</strong>
        </div>
    {% endif %}

    {% if lastproduit %}
        <div class="alert alert-primary mb-4">
            Promo 20% sur : <strong>{{ lastproduit.nom }}</strong>
        </div>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex gap-2 mb-4">
            <a href="{{ path('admin_insert') }}" class="btn btn-info">
                + Ajouter un produit
            </a>
            <a href="{{ path('admin_categories') }}" class="btn btn-secondary">
                Gerer les categories
            </a>
        </div>
    {% endif %}

    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for produit in listeproduits %}
            <div class="col">
                <div class="card h-100">
                    <img src="{{ asset('img/' ~ produit.lienImage) }}"
                         class="card-img-top" alt="{{ produit.nom }}"
                         style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{ produit.nom }}</h5>
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item">Prix : {{ produit.prix }} €</li>
                            <li class="list-group-item">
                                {% if produit.rupture %}
                                    <strong class="text-danger">Rupture de stock</strong>
                                {% else %}
                                    Stock : {{ produit.quantite }}
                                {% endif %}
                            </li>
                            {% if produit.description %}
                                <li class="list-group-item">
                                    Description :<br>
                                    <div>{{ produit.description }}</div>
                                </li>
                            {% endif %}
                            <li class="list-group-item">
                                Categories :
                                {% if produit.categories is not empty %}
                                    {% for categorie in produit.categories %}
                                        <span class="badge bg-secondary">{{ categorie.nom }}</span>
                                    {% endfor %}
                                {% else %}
                                    <span class="text-muted">Aucune</span>
                                {% endif %}
                            </li>
                        </ul>
                        <div class="mt-auto">
                            <a href="#" class="btn btn-primary btn-sm w-100 mb-2">Ajouter au panier</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_update', {id: produit.id}) }}"
                                   class="btn btn-warning btn-sm w-100 mb-2">Modifier</a>

                                <form method="post" action="{{ path('admin_delete', {id: produit.id}) }}"
                                      onsubmit="return confirm('Supprimer {{ produit.nom }} ?');" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ produit.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm w-100">Supprimer</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center">
                    Aucun produit pour le moment...
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
